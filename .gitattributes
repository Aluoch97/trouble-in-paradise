# Keep line endings consistent between Windows and Mac/Linux teammates
* text=auto eol=lf

# Godot text formats
*.gd text eol=lf
*.tscn text eol=lf
*.tres text eol=lf
*.gdshader text eol=lf
*.godot text eol=lf
*.import text eol=lf

# Binary assets: never merge, never change line endings
*.png binary
*.jpg binary
*.webp binary
*.ogg binary
*.mp3 binary
*.wav binary
*.glb binary
*.gltf binary
*.blend binary
*.fbx binary
*.ttf binary
*.otf binary
*.woff2 binary
